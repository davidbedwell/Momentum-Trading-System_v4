{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mts:schema:artifact-reference:1",
  "schema_id": "mts.artifact-reference",
  "schema_version": 1,
  "status": "INITIAL",
  "title": "MTS Artifact Reference",
  "description": "Stable reference to one governed artifact version. Locators and filesystem paths are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "artifact_version"],
  "properties": {
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_version": {"type": "integer", "minimum": 1}
  }
}
