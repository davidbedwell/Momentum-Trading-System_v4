{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mts:schema:market-history:1",
  "schema_id": "mts.market-history",
  "schema_version": 1,
  "status": "INITIAL",
  "title": "MTS Market History Payload",
  "description": "Canonical Intake payload describing normalized market observations and deterministic contemporaneous measurements. Research interpretation is excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "symbol",
    "timeframe",
    "semantic_fingerprint",
    "materialization_policy",
    "observed_columns",
    "measurement_columns",
    "records",
    "quality_report",
    "computation_audit"
  ],
  "properties": {
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "timeframe": {
      "type": "string",
      "minLength": 1
    },
    "semantic_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Deterministic fingerprint of governed semantic/version inputs; not Nexus artifact_version."
    },
    "materialization_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "version",
        "families",
        "measurement_names"
      ],
      "properties": {
        "mode": {
          "enum": [
            "ACTIVE_FAMILIES",
            "EXPLICIT_MEASUREMENTS",
            "OBSERVATIONS_ONLY"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "families": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "measurement_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "observed_columns": {
      "type": "array",
      "items": {
        "enum": [
          "date",
          "open",
          "high",
          "low",
          "close",
          "volume"
        ]
      },
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true
    },
    "measurement_columns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "date",
          "open",
          "high",
          "low",
          "close",
          "volume"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "open": {
            "type": "number"
          },
          "high": {
            "type": "number"
          },
          "low": {
            "type": "number"
          },
          "close": {
            "type": "number"
          },
          "volume": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": {
          "type": [
            "number",
            "integer",
            "boolean",
            "string",
            "null"
          ]
        }
      }
    },
    "quality_report": {
      "type": "object"
    },
    "computation_audit": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
