{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mts:schema:analysis-execution:1",
  "schema_id": "mts.analysis-execution",
  "schema_version": 1,
  "status": "INITIAL",
  "title": "MTS Analysis Execution Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_id",
    "task_id",
    "context_fingerprint",
    "engine_version",
    "input_refs",
    "execution_state",
    "method_executions",
    "output_refs",
    "limitations"
  ],
  "properties": {
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "context_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "artifact_version"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "artifact_version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "execution_state": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "BLOCKED",
        "CANCELLED",
        "NOT_APPLICABLE",
        "RETRYABLE_FAILURE"
      ]
    },
    "method_executions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "output_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "artifact_version"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "artifact_version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retry_of": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
